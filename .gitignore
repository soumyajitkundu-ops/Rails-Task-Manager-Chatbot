# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Ignore key files for decrypting credentials and more.
/config/*.key

# ==========================================
# React / Node Dependencies & Build Artifacts (Deep Wildcards)
# ==========================================
**/node_modules/
**/npm-debug.log*
**/yarn-error.log*
**/yarn-debug.log*
**/.pnp
**/.pnp.js

# React build outputs (Catches 'build' or 'dist' at any depth)
**/build/
**/dist/

# ==========================================
# Rails Database, Logs, and Temp Files
# ==========================================
**/log/*.log
**/tmp/
**/db/*.sqlite3
**/db/*.sqlite3-journal
**/db/*.sqlite3-wal

# Storage, uploads, and assets
**/storage/
**/public/assets
**/public/packs
**/public/packs-test
**.web-assets-cache
/vendor/bundle/

# Local credentials and generated API output
/cookies.txt
/token.txt
/login_response.json
/register_response.json
/output.txt
/.kamal/secrets

# ==========================================
# Environment Variables & Secrets (CRITICAL)
# ==========================================
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
**/config/master.key
**/config/credentials/*.key

# ==========================================
# OS and Editor Specific Files
# ==========================================
**/.DS_Store
**/Thumbs.db
**/.vscode/
**/.idea/
**/*.suo
**/*.ntvs*
**/*.njsproj
**/*.sln
**/*.sw?

